{
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "lint:yml": "eslint -c ./config/.eslintrc.json --ext .yml --ext .yaml --no-error-on-unmatched-pattern --color",
    "lint:yml:fix": "eslint -c ./config/.eslintrc.json --ext .yml --ext .yaml --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint app/**/*.css --aei --cache --cache-location node_modules/.cache/stylelint/ --color",
    "lint:style:fix": "stylelint app/**/*.css --aei --cache --cache-location node_modules/.cache/stylelint/ --fix"
  },
  "devDependencies": {
    "cspell": "^9.8.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-yml": "^1.19.1",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3"
  },
  "packageManager": "pnpm@12.3.2",
  "engines": {
    "pnpm": ">=12",
    "node": ">=26"
  },
  "prettier": {
    "singleQuote": true,
    "proseWrap": "always",
    "bracketSameLine": true
  }
}
