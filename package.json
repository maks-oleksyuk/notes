{
    "homepage": "https://maks-oleksyuk.github.io/notes",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "prettier": "^3.6.2",
        "validate-branch-name": "^1.3.2"
    },
    "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
    "engines": {
        "pnpm": ">=10",
        "node": ">=24"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "validate-branch-name": {
        "pattern": "^(symfony|(feature|fix|hotfix|chore)/[a-z0-9]+(?:-[a-z0-9]+)*)$",
        "errorMsg": "❌ Invalid branch name."
    }
}
