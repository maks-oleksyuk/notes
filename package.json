{
    "homepage": "https://maks-oleksyuk.github.io/notes",
    "license": "GPL-3.0-or-later",
    "author": {
        "name": "Maks Oleksyuk",
        "url": "https://github.com/maks-oleksyuk"
    },
    "type": "module",
    "private": true,
    "scripts": {
        "spellcheck": "cspell -c config/utils/.cspell.json '**' --quiet --color",
        "lint:format": "prettier !**/pnpm-lock.yaml -c --cache --no-error-on-unmatched-pattern --color",
        "lint:format:fix": "prettier !**/pnpm-lock.yaml -wl --cache --no-error-on-unmatched-pattern"
    },
    "devDependencies": {
        "cspell": "^8.15.5",
        "prettier": "^3.3.3"
    },
    "packageManager": "pnpm@9.10.0",
    "engines": {
        "pnpm": ">=9",
        "node": ">=20"
    },
    "prettier": {
        "singleQuote": true,
        "proseWrap": "always",
        "bracketSameLine": true
    }
}
