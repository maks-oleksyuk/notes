{
    "name": "maks-oleksyuk/laravel-notes",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.4",
        "filament/filament": "^3.3",
        "laravel/framework": "^12.2",
        "laravel/pulse": "^1.4",
        "olssonm/l5-very-basic-auth": "^7.2",
        "opcodesio/log-viewer": "^3.15",
        "spatie/laravel-data": "^4.14"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan app:setup --ansi"
        ]
    }
}
