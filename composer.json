{
    "name": "maks-oleksyuk/drupal-notes",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal-notes/app_main": "^1.0@dev",
        "drupal-notes/app_theme": "^1.0@dev",
        "drupal/core-composer-scaffold": "^12.0.0-alpha1",
        "drupal/core-recommended": "^12.0.0-alpha1",
        "drush/drush": "14.x-dev",
        "skilldlabs/drupal-cleanup": "^1.4"
    },
    "require-dev": {
        "drupal/core-dev": "^12.0.0-alpha1",
        "mglaman/phpstan-drupal": "^2.1.2",
        "palantirnet/drupal-rector": "^1.1.3",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "path",
            "url": "app/**/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "skilldlabs/drupal-cleanup": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "Issue #3620907: default_admin theme: logo and navigation icons don't align in the collapsed sidebar. Same fix as https://git.drupalcode.org/project/drupal/-/merge_requests/17001, rebased on gin--navigation (our 12.0.0-alpha1) instead of admin--navigation (renamed on main after alpha1 was tagged)": "patches/default-admin-inherit-core-sidebar-width.patch"
            }
        },
        "drupal-cleanup": {
            "drupal-core": [
                "tests",
                "modules/*/tests",
                "modules/*/src/Tests",
                "themes/*/tests",
                "themes/*/src/Tests",
                "profiles/demo_umami",
                "profiles/*test*",
                "profiles/*/tests"
            ],
            "drupal-module": [
                "tests",
                "src/Tests"
            ],
            "drupal-theme": [
                "tests",
                "src/Tests"
            ]
        },
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/sites/default/settings.php": "assets/scaffold/settings.php"
            },
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    },
    "scripts": {
        "dump:db": "mkdir -p dump; drush sql:dump --structure-tables-list=cache,cache_*,search_index,watchdog > dump/db_$(date +%Y.%m.%d_%H:%M_%:::z).sql.gz --gzip",
        "dump:files": "mkdir -p dump; drush ard --files --destination=../dump/files_$(date +%Y.%m.%d_%H:%M_%:::z).tar.gz"
    },
    "scripts-descriptions": {
        "dump:db": "Dump database using Drush in dump directory",
        "dump:files": "Archive public files using Drush in dump directory"
    }
}
