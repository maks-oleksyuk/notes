{
    "name": "maks-oleksyuk/symfony-notes",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.4.1",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.2",
        "easycorp/easyadmin-bundle": "^4.29.1",
        "lexik/jwt-authentication-bundle": "^3.2.0",
        "nelmio/api-doc-bundle": "^5.9.4",
        "symfony/console": "^8.0.4",
        "symfony/dotenv": "^8.0",
        "symfony/flex": "^2.10.0",
        "symfony/framework-bundle": "^8.0.5",
        "symfony/monolog-bundle": "^4.0.1",
        "symfony/object-mapper": "^8.0.5",
        "symfony/runtime": "^8.0.1",
        "symfony/security-bundle": "^8.0.4",
        "symfony/serializer": "^8.0.5"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-doctrine": "^2.0.17",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-strict-rules": "^2.0.10",
        "phpstan/phpstan-symfony": "^2.0.14",
        "phpunit/phpunit": "^13.0.5",
        "rector/rector": "^2.3.8",
        "symfony/browser-kit": "^8.0.4",
        "symfony/css-selector": "^8.0",
        "symfony/maker-bundle": "^1.66",
        "symfony/phpunit-bridge": "^8.0.3",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0.4",
        "vincentlanglet/twig-cs-fixer": "^3.14.0"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "public-dir": "web"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
