{
    "name": "maks-oleksyuk/notes-symfony",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.6",
        "easycorp/easyadmin-bundle": "^5.9",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/api-doc-bundle": "^5.13.2",
        "symfony/console": "^8.1.11",
        "symfony/dotenv": "^8.1.6",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "^8.1.11",
        "symfony/monolog-bundle": "^4.1",
        "symfony/object-mapper": "^8.1.11",
        "symfony/runtime": "^8.1.11",
        "symfony/security-bundle": "^8.1.11",
        "symfony/serializer": "^8.1.11",
        "twig/extra-bundle": "^3.29",
        "zircote/swagger-php": "^6.20"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "rector/rector": "^2.8.4",
        "symfony/browser-kit": "^8.1.11",
        "symfony/css-selector": "^8.1.10",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1.10",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.11",
        "vincentlanglet/twig-cs-fixer": "^4.1.1"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
