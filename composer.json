{
    "name": "maks-oleksyuk/notes-laravel",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.2.4",
        "grazulex/laravel-apiroute": "^2.0.5",
        "knuckleswtf/scribe": "^5.8",
        "laravel/framework": "^12.53",
        "laravel/nightwatch": "^1.24",
        "laravel/octane": "^2.14.0",
        "laravel/pulse": "^1.6",
        "laravel/sanctum": "^4.3.1",
        "laravel/socialite": "^5.24.3",
        "olssonm/l5-very-basic-auth": "^7.3",
        "opcodesio/log-viewer": "^3.21.1",
        "sentry/sentry-laravel": "^4.21",
        "spatie/laravel-data": "^4.20"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "driftingly/rector-laravel": "^2.1.9",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.0.10",
        "larastan/larastan": "^3.9.3",
        "laravel/boost": "^2.2.1",
        "laravel/pint": "^1.27.1",
        "mockery/mockery": "^1.6.12",
        "mrpunyapal/rector-pest": "^0.2.3",
        "peckphp/peck": "^0.2",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.3",
        "php-mock/php-mock-phpunit": "^2.15",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "spatie/pest-plugin-route-testing": "^1.1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan app:setup --ansi"
        ],
        "post-update-cmd": [
            "@php artisan boost:update --ansi"
        ]
    }
}
