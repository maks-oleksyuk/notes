{
    "name": "maks-oleksyuk/notes-drupal",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "app/main": "^1.0@dev",
        "app/theme": "^1.0@dev",
        "drupal/core-composer-scaffold": "^12.0@beta",
        "drupal/core-recommended": "^12.0@beta",
        "drush/drush": "^14@dev"
    },
    "require-dev": {
        "chi-teck/drupal-coder-extension": "^2.1.1",
        "drupal/core-dev": "^12.0@beta",
        "mglaman/phpstan-drupal": "^2.4",
        "palantirnet/drupal-rector": "^1.2",
        "vincentlanglet/twig-cs-fixer": "^4.1.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "path",
            "url": "app/**/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "#3620907: default_admin theme: logo and navigation icons don't align in the collapsed sidebar": "patches/default-admin-inherit-core-sidebar-width.patch",
                "default_admin: top bar padding is too large on mobile": "patches/default-admin-top-bar-padding.patch"
            }
        },
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/sites/default/settings.php": "assets/scaffold/settings.php"
            },
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    }
}
