{
    "name": "maks-oleksyuk/notes-laravel",
    "description": "Project for my notes and tests.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5",
        "chrome-php/chrome": "^1.16.1",
        "filament/filament": "^5.10.3",
        "grazulex/laravel-apiroute": "^2.3.0",
        "knuckleswtf/scribe": "^5.11",
        "laravel/framework": "^13.38.0",
        "laravel/nightwatch": "^1.30.5",
        "laravel/octane": "^2.22.0",
        "laravel/pulse": "^1.8.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31",
        "maatwebsite/excel": "^4.0.6",
        "olssonm/l5-very-basic-auth": "^7.4",
        "opcodesio/log-viewer": "^3.24.2",
        "phpstan/phpdoc-parser": "^2.3.6",
        "sentry/sentry-laravel": "^4.29",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-permission": "^8.3.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.7.0",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.4",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.3",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5",
        "pestphp/pest-plugin-mutate": "^5.0.2",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "php-mock/php-mock-phpunit": "^2.16",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-mockery": "^2",
        "spatie/pest-plugin-route-testing": "^1.2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan app:setup --ansi"
        ],
        "post-update-cmd": [
            "@php artisan boost:update --ansi"
        ]
    }
}
