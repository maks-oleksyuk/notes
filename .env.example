# Laravel:
APP_NAME=Notes
APP_ENV=local
APP_DEBUG=false
APP_URL=
APP_KEY=

# Octane:
OCTANE_HTTPS=true
OCTANE_SERVER=frankenphp

# Database:
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
DB_CONNECTION=pgsql

# Logging:
LOG_STACK=sentry,nightwatch

# Mail:
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_MAILER=smtp

# Very basic auth:
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# Nightwatch:
NIGHTWATCH_TOKEN=

# Sentry:
SENTRY_LARAVEL_DSN=
SENTRY_ENABLE_LOGS=true

# Google:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
