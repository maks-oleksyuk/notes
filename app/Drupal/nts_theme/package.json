{
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "webpack --progress --watch",
    "build": "webpack --progress --mode production --node-env production ",
    "lint": "run-p -cls lint:js lint:style lint:format",
    "lint:fix": "run-p -cls lint:*:fix",
    "lint:js": "eslint js --no-error-on-unmatched-pattern --color",
    "lint:js:fix": "eslint js --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint styles --aei --cache --cache-location node_modules/.cache/stylelint/ --color",
    "lint:style:fix": "stylelint styles --aei --cache --cache-location node_modules/.cache/stylelint/ --fix",
    "lint:format": "prettier styles js -c --cache --no-error-on-unmatched-pattern --color",
    "lint:format:fix": "prettier styles js -wl --cache --no-error-on-unmatched-pattern",
    "postinstall": "sed -i '/\"airbnb-base\",/d;/^ *$/d' ../../../web/core/.eslintrc.json || true"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "glob": "^13.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-loader": "^8.2.0",
    "postcss-perfectionist": "^2.3.9",
    "postcss-rtl-logical-properties": "^2.0.1",
    "postcss-rtlcss": "^5.7.1",
    "sass": "^1.94.2",
    "sass-loader": "^16.0.6",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-yml": "^1.19.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "stylelint": "^16.26.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.12.1"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "pnpm": ">=10",
    "node": ">=24"
  },
  "eslintConfig": {
    "extends": [
      "../../../web/core/.eslintrc.passing.json",
      "airbnb-base"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "proseWrap": "always",
    "bracketSameLine": true
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss",
      "../../../web/core/.stylelintrc.json"
    ],
    "plugins": [
      "stylelint-scss"
    ]
  }
}
