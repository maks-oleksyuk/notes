{% extends 'base.html.twig' %}

{% block title %}{{ 'Maintenance Mode' }}{% endblock %}

{% block body %}
    <div class="maintenance">
        <h1>{{ 'Site temporarily under maintenance' }}</h1>
        <p>{{ 'Sorry for the inconvenience, we will get back soon!' }}</p>
    </div>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: Verdana, sans-serif;
            background: #000000;
            background: linear-gradient(to bottom, #000000 60%, #966a19);
        }

        .maintenance {
            color: white;
            text-align: center;
            padding-top: 20dvh;
            display: flex;
            flex-direction: column;
        }
    </style>
{% endblock %}
