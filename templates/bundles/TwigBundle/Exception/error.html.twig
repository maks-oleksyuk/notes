{% extends 'base.html.twig' %}

{% block title %}{{ status_code }} {{ status_text }}{% endblock %}

{% block body %}
    <div class="error-page">
        <span class="code">{{ status_code }}</span>
        <span class="message">{{ status_text }}</span>
    </div>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            font-family: Verdana, sans-serif;
        }

        .error-page {
            color: #ffffff;
            display: flex;
            align-items: center;
            font-weight: 100;
            user-select: none;
        }

        .code {
            border-right: 1px solid rgba(255, 255, 255, 0.3);
            padding-right: 1rem;
            margin-right: 1rem;
            font-size: 1.75rem;
        }

        .message {
            font-size: 1rem;
        }
    </style>
{% endblock %}
