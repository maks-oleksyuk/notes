includes:
  - ../../vendor/larastan/larastan/extension.neon
  - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
  level: 10
  paths:
    - ../../app
    - ../../database
  tmpDir: ../../var/cache/phpstan
  ignoreErrors:
    - '#PHPDoc tag @mixin contains unknown class App\\Models\\IdeHelper#'
