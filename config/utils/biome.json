{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": true,
            "groups": [
              { "type": false, "source": [":NODE:", ":BUN:"] },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":ALIAS:", "!*.css", "!*.scss", "!*.sass", "!*.less"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":PATH:", "!*.css", "!*.scss", "!*.sass", "!*.less"]
              },
              ":BLANK_LINE:",
              ":STYLE:",
              ":BLANK_LINE:",
              { "type": true }
            ]
          }
        },
        "useSortedProperties": "on",
        "noDuplicateClasses": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!packages",
      "!public",
      "!var",
      "!next-env.d.ts",
      "!!config/utils/biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        }
      }
    }
  },
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "root": ".."
  }
}
