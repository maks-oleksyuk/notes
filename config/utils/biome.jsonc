{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              { "source": [":NODE:", ":BUN:"], "type": false },
              ":BLANK_LINE:",
              { "source": [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"], "type": false },
              ":BLANK_LINE:",
              { "source": [":ALIAS:", "!*.css", "!*.scss", "!*.sass", "!*.less"], "type": false },
              ":BLANK_LINE:",
              { "source": [":PATH:", "!*.css", "!*.scss", "!*.sass", "!*.less"], "type": false },
              ":BLANK_LINE:",
              ":STYLE:",
              ":BLANK_LINE:",
              { "type": true }
            ],
            "sortBareImports": true
          }
        },
        "useSortedPackageJson": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!public", "!!config/utils/biome.jsonc"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "noDivRegex": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noRedundantDefaultExport": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useMaxParams": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noGlobalDirnameFilename": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noPrivateImports": "error",
        "noReactPropAssignments": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "error",
        "noUnusedInstantiation": "error",
        "useJsonImportAttributes": "error",
        "useSingleJsDocAsterisk": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noComponentHookFactories": "error",
        "noConditionalExpect": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noIdenticalTestTitle": "error",
        "noImpliedEval": "error",
        "noInlineStyles": "error",
        "noInvalidFileInputAccept": "error",
        "noInvalidPropertyInitValue": "error",
        "noJsonUnsafeValues": "error",
        "noJsxLeakedDollar": "error",
        "noJsxNamespace": "error",
        "noLoopFunc": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisplacedListElements": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNonScalableViewport": "error",
        "noObsoleteTags": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noReactStringRefs": "error",
        "noRestrictedDependencies": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noTailwindArbitraryValue": "error",
        "noThisOutsideOfClass": "error",
        "noTopLevelLiterals": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUselessTypeConversion": "error",
        "noXorAsExponentiation": "error",
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useBaseline": "error",
        "useBetterDomTraversing": "error",
        "useConsistentTestIt": "error",
        "useControlLabel": "error",
        "useDisposables": "error",
        "useDomNodeTextContent": "error",
        "useDomQuerySelector": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpect": "error",
        "useFlatMathMinMax": "error",
        "useIframeSandbox": "error",
        "useImportsFirst": "error",
        "useIncludes": "error",
        "useLogicalProperties": "error",
        "useMathMinMax": "error",
        "useModernMathApis": "error",
        "useNamedCaptureGroup": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "error",
        "usePromiseRejectErrors": "error",
        "useReactAsyncServerFunction": "error",
        "useReactCompiler": "error",
        "useReactFunctionComponentDefinition": "error",
        "useReactNamingConvention": "error",
        "useReduceTypeParameter": "error",
        "useRegexpExec": "error",
        "useRegexpTest": "error",
        "useSortedClasses": "error",
        "useStringStartsEndsWith": "error",
        "useTailwindShorthandClasses": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error",
        "useUnicodeRegex": "error",
        "useValidTestTitle": "error",
        "useVarsOnTop": "error"
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noDelete": "error",
        "noImgElement": "error",
        "noNamespaceImport": "error",
        "noSyncScripts": "error"
      },
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExportedImports": "error",
        "noHeadElement": "error",
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentCurlyBraces": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useEnumInitializers": "error",
        "useExplicitLengthCheck": "error",
        "useExportsLast": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        "useNodeAssertStrict": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateTestHooks": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noEvolvingTypes": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noImportCycles": "error",
        "noLeakedRender": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noReactForwardRef": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noUnnecessaryConditions": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useDeprecatedDate": "error",
        "useErrorMessage": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "next.config.ts",
        "config/utils/vitest.config.mts",
        "config/utils/vitest.browser.config.mts",
        "src/lib/env/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "usePromiseRejectErrors": "off"
          },
          "style": {
            "useThrowOnlyError": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "root": ".",
    "useIgnoreFile": true
  }
}