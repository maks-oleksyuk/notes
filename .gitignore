# Ignore directories generated by package managers.
web
vendor
node_modules

# Ignore the dist directory with built theme style files.
dist

# Ignore Drupal private file directory.
/private

# Ignore scaffold files provided by drupal:scaffold.
.gitattributes
.editorconfig

# Ignore temporary files and cache directories.
var
cache
.temp
.pnpm-store

# Ignore .env files as they are personal.
.env*
!.env.example

# Ignore development tool files.
.ddev
.idea
.vscode

# Ignore dump folder and archives.
local
*.sql
*.gz

# Ignore OS files.
.DS_Store
